---
import PageLayout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, I18N } from 'astrowind:config';

const metadata = {
  title: 'Frexida',
  ignoreTitleTemplate: true,
  description: 'Frexidaは、既存の機械に知能を載せ、自律的に動く機械の実用化を目指します。',
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL('/images/frexida-logo.png', SITE?.site).toString(),
  },
];

const companyInfo = [
  ['代表', '松田 直和'],
  ['所在地', '会津大学'],
  ['事業内容', 'ソフトウェア開発・機械設計・システム導入'],
  ['Webサイト', 'www.frexida.com'],
  ['連絡先', 'contact[at]frexida.com'],
];

const principles = [
  {
    name: 'Mission',
    definition: '何のために存在するか',
    statement: '災害被害を最小限に抑える',
  },
  {
    name: 'Vision',
    definition: '作りたい未来・あるべき姿',
    statement: '自律的に動く機械を実用化し、人命と社会インフラを守る',
  },
  {
    name: 'Value',
    definition: '提供価値・行動指針',
    statement: '危険な作業と軽度の判断の繰り返しを機械に代替する',
  },
];

const axes = [
  {
    name: '防災',
    meaning: '社会課題への貢献',
    expression: '災害被害を最小限に抑える',
  },
  {
    name: '持続性',
    meaning: '事業を継続できる収益をつくる',
    expression: '製造業支援',
  },
  {
    name: '探究',
    meaning: '新しい技術・現場・可能性を探る',
    expression: 'AIエージェントの実験・実装',
  },
];
---

<PageLayout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />
  <Fragment slot="footer"></Fragment>

  <header slot="header" class="site-header">
    <a class="brand" href="/" aria-label="Frexida ホーム">
      <img src="/images/frexida-logo.png" alt="" width="36" height="36" />
      <span>Frexida</span>
    </a>
  </header>

  <main class="home-shell">
    <section class="hero section-frame" aria-labelledby="hero-title">
      <div class="simulation-frame">
        <video
          class="simulation-video"
          src="/videos/frexida-robot-simulation.mp4"
          poster="/images/robot-simulation-poster.webp"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label="MuJoCo上で動作するロボットアームのシミュレーション"
        >
          お使いのブラウザーは動画再生に対応していません。
        </video>
        <div class="video-glass" aria-hidden="true"></div>
        <div class="hero-copy">
          <h1 id="hero-title">知能を<br />現実の動きへ。</h1>
        </div>
      </div>
    </section>

    <section class="content-section solution-section section-frame" aria-label="事業内容">
      <div class="solution-copy">
        <p class="solution-lead">私たちは、既存の機械に知能を載せ、<br />価値を大きく拡張する。</p>
        <p>
          専用機械を一から作るのではなく、既存設備や汎用アームを活用する。機械・治具の設計からソフトウェア開発、現場へのシステム導入まで一貫して行い、人のように状況を判断する仕組みで現場の課題を解決する。
        </p>
        <p>
          IoT化によって現場のデータを取り込み、AIエージェントと接続する土台を作る。そして自律的な機械へと繋げていく。
        </p>
      </div>
    </section>

    <section class="content-section principles-section section-frame" aria-labelledby="principles-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">MISSION / VISION / VALUE</p>
          <h2 id="principles-title">Frexidaの考え方</h2>
        </div>
      </div>
      <div class="principles-list">
        {
          principles.map((principle) => (
            <article class="principle-row">
              <div class="principle-name">
                <h3>{principle.name}</h3>
                <p>{principle.definition}</p>
              </div>
              <p class="principle-statement">{principle.statement}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="content-section axes-section section-frame" aria-labelledby="axes-title">
      <div class="section-heading">
        <div>
          <h2 id="axes-title">事業を支える三つの軸</h2>
        </div>
      </div>
      <div class="axes-grid">
        {
          axes.map((axis) => (
            <article class="axis-item">
              <h3>{axis.name}</h3>
              <p class="axis-meaning">{axis.meaning}</p>
              <p class="axis-expression">{axis.expression}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="content-section company-section section-frame" aria-labelledby="company-title">
      <div class="section-heading">
        <h2 id="company-title">会社情報</h2>
      </div>
      <dl class="company-list">
        {
          companyInfo.map(([label, value]) => (
            <div class="company-row">
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </main>
</PageLayout>

<style>
  :global(html) {
    background: #191a1c;
  }

  :global(body) {
    background: #191a1c;
    color: #f1f0ec;
  }

  .site-header {
    position: absolute;
    z-index: 5;
    inset: 0 0 auto;
    width: 100%;
    padding: 1.1rem clamp(1.25rem, 5vw, 5rem);
    background: linear-gradient(180deg, rgb(15 17 20 / 55%), transparent);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: #f1f0ec;
    font-family: var(--font-space-grotesk), 'Space Grotesk', var(--font-inter), sans-serif;
    font-size: 1.45rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .brand img {
    width: 3rem;
    height: 3rem;
    object-fit: contain;
  }

  .home-shell {
    --ink: #f1f0ec;
    --muted-ink: #b7b8bd;
    --line: #414348;
    --indigo: #526b9b;
    --page: #191a1c;
    --raised: #242629;
    overflow: hidden;
    background: var(--page);
    color: var(--ink);
  }

  .section-frame {
    width: min(100% - 3rem, 76rem);
    margin-inline: auto;
  }

  .hero {
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    margin: 0;
    padding: 0;
  }

  .hero-copy {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: flex;
    align-items: center;
    padding: clamp(1.5rem, 7vw, 6rem);
    pointer-events: none;
  }

  .eyebrow {
    margin: 0;
    color: #9ba7c0;
    font-family: var(--font-inter), Inter, sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .eyebrow span {
    padding-inline: 0.25rem;
    color: var(--indigo);
  }

  .hero h1 {
    margin: 0;
    color: #f1f0ec;
    font-family: 'Yu Mincho', YuMincho, 'Hiragino Mincho ProN', 'Noto Serif JP', 'BIZ UDPMincho', serif;
    font-size: clamp(2.8rem, 10vw, 8rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.45;
  }

  .simulation-frame {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
    height: 100vh;
    height: 100svh;
    background: #25282d;
  }

  .simulation-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #202226;
  }

  .video-glass {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: rgb(18 21 27 / 62%);
    backdrop-filter: blur(5px) saturate(65%);
    -webkit-backdrop-filter: blur(5px) saturate(65%);
    pointer-events: none;
  }

  .content-section {
    padding-block: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid var(--line);
  }

  .section-heading {
    margin-left: clamp(0rem, 5vw, 4.5rem);
    margin-bottom: 2.5rem;
  }

  .section-heading .eyebrow {
    margin-bottom: 0.55rem;
  }

  .section-heading h2 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.6rem, 3vw, 2.5rem);
    font-weight: 500;
    letter-spacing: 0.015em;
    line-height: 1.4;
  }

  .solution-copy {
    max-width: 58rem;
    margin-left: clamp(0rem, 5vw, 4.5rem);
  }

  .solution-copy p {
    margin: 1.25rem 0 0;
    color: var(--muted-ink);
    font-size: 1rem;
    line-height: 2.05;
  }

  .solution-copy .solution-lead {
    margin-top: 0;
    color: var(--ink);
    font-size: clamp(1.65rem, 3.6vw, 2.9rem);
    font-weight: 500;
    letter-spacing: 0.005em;
    line-height: 1.55;
  }

  .principles-list {
    margin-left: clamp(0rem, 5vw, 4.5rem);
    border-top: 1px solid var(--line);
  }

  .principle-row {
    display: grid;
    grid-template-columns: minmax(11rem, 0.7fr) minmax(0, 1.6fr);
    gap: 2rem;
    align-items: start;
    padding: 1.8rem 0;
    border-bottom: 1px solid var(--line);
  }

  .principle-name h3 {
    margin: 0;
    color: #9ba7c0;
    font-family: var(--font-inter), Inter, sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .principle-name p {
    margin: 0.45rem 0 0;
    color: #8f9197;
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .principle-statement {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.08rem, 2vw, 1.45rem);
    line-height: 1.9;
  }

  .axes-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-left: clamp(0rem, 5vw, 4.5rem);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .axis-item {
    padding: 1.7rem clamp(1rem, 2vw, 2rem) 2rem;
  }

  .axis-item:first-child {
    padding-left: 0;
  }

  .axis-item + .axis-item {
    border-left: 1px solid var(--line);
  }

  .axis-item h3 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.25rem, 2vw, 1.7rem);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .axis-meaning {
    min-height: 3rem;
    margin: 0.6rem 0 0;
    color: #9ba7c0;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .axis-expression {
    min-height: 5.2rem;
    margin: 1rem 0 0;
    color: var(--muted-ink);
    font-size: 0.92rem;
    line-height: 1.85;
  }

  .company-list {
    margin: 0 0 0 clamp(0rem, 5vw, 4.5rem);
    border-top: 1px solid var(--line);
  }

  .company-row {
    display: grid;
    grid-template-columns: minmax(9rem, 0.55fr) minmax(0, 1.45fr);
    gap: 1.5rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }

  .company-row dt {
    color: #9ba7c0;
    font-size: 0.88rem;
  }

  .company-row dd {
    margin: 0;
    color: var(--ink);
    font-size: 0.95rem;
  }

  @media (max-width: 700px) {
    .section-frame {
      width: min(100% - 2rem, 76rem);
    }

    .hero {
      width: 100%;
      min-height: 100vh;
      min-height: 100svh;
      padding: 0;
    }

    .simulation-frame {
      height: 100vh;
      height: 100svh;
    }

    .simulation-video {
      height: 100%;
    }

    .hero-copy {
      padding: 1.5rem;
    }

    .hero h1 {
      font-size: clamp(2.8rem, 12vw, 4.8rem);
    }

    .solution-copy,
    .section-heading,
    .principles-list,
    .axes-grid,
    .company-list {
      margin-left: 0;
    }

    .principle-row {
      grid-template-columns: 1fr;
      gap: 0.65rem;
      padding: 1.35rem 0;
    }

    .axes-grid {
      grid-template-columns: 1fr;
    }

    .axis-item,
    .axis-item:first-child {
      padding: 1.35rem 0;
    }

    .axis-item + .axis-item {
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .axis-meaning,
    .axis-expression {
      min-height: 0;
    }

    .company-row {
      grid-template-columns: 6rem minmax(0, 1fr);
      gap: 0.75rem;
    }
  }
</style>

<script>
  const simulation = document.querySelector<HTMLVideoElement>('.simulation-video');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const syncSimulationPlayback = () => {
    if (!simulation) return;
    if (reduceMotion.matches) simulation.pause();
    else simulation.playbackRate = 1.8;
  };

  syncSimulationPlayback();
  reduceMotion.addEventListener('change', syncSimulationPlayback);
</script>
